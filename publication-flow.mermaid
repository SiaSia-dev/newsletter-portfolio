flowchart TD
    start(Début du workflow) --> trigger{Déclenchement}
    
    %% Mécanismes de déclenchement
    trigger -->|Automatique: Tous les lundis à 9h| cron[Planification hebdomadaire]
    trigger -->|Automatique: Après génération newsletter| webhook[Événement GitHub]
    trigger -->|Manuel| manual[Déclenchement manuel]
    
    cron --> checkout
    webhook --> checkout
    manual --> checkout
    
    %% Étapes de préparation
    checkout[Checkout des dépôts] --> deps[Installation des dépendances]
    deps --> validateToken[Validation du token LinkedIn]
    validateToken --> checkLock[Vérification du verrou hebdomadaire]
    
    %% Logique de verrouillage hebdomadaire
    checkLock --> isLocked{Déjà publié cette semaine?}
    isLocked -->|Oui| forceCheck{Force Publish activé?}
    isLocked -->|Non| findFile[Recherche du fichier de newsletter]
    forceCheck -->|Oui| cleanLock[Nettoyage du verrou] --> findFile
    forceCheck -->|Non| earlyExit[Annulation - déjà publié]
    
    %% Préparation de la publication
    findFile --> latest{latest.html existe?}
    latest -->|Oui| useLatest[Utilisation de latest.html]
    latest -->|Non| findRecent[Recherche du fichier le plus récent]
    
    findRecent --> createUrl[Création de l'URL publique]
    useLatest --> createUrl
    
    createUrl --> parseHtml[Extraction des données HTML]
    parseHtml --> extractData[Extraction du titre, date, projets]
    
    %% Publication LinkedIn
    extractData --> publish[Publication sur LinkedIn]
    publish --> tryVariants[Essai de différentes variantes de message]
    tryVariants --> isSuccess{Publication réussie?}
    
    isSuccess -->|Oui| createLock[Création du verrou hebdomadaire]
    isSuccess -->|Non, contenu dupliqué| retryVariant[Essai autre variante]
    retryVariant -->|5 tentatives max| isSuccess
    
    isSuccess -->|Non, après toutes les tentatives| failExit[Échec de la publication]
    
    %% Finalisation
    createLock --> logSuccess[Enregistrement de la publication]
    logSuccess --> success(Fin: Succès)
    
    earlyExit --> skipExit(Fin: Ignoré - déjà publié)
    failExit --> failure(Fin: Échec)
    
    %% Légende et style
    classDef success fill:#c2f0c2,stroke:#0f5,stroke-width:2px;
    classDef failure fill:#f0c2c2,stroke:#f55,stroke-width:2px;
    classDef process fill:#c2d1f0,stroke:#55f,stroke-width:1px;
    classDef decision fill:#f5f0c2,stroke:#fa0,stroke-width:1px;
    
    class success,createLock,logSuccess success;
    class failure,failExit failure;
    class checkout,deps,validateToken,findFile,parseHtml,extractData,publish,tryVariants,cleanLock,useLatest,findRecent,createUrl,retryVariant process;
    class trigger,isLocked,forceCheck,latest,isSuccess decision;
